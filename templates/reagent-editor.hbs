<form class="reagent-editor">
    <div class="form-group">
        <label>Reagent Table (JSON)</label>
        <textarea name="table" rows="18" spellcheck="false">{{tableJson}}</textarea>
        <p class="notes">
            Array of objects. Recommended fields: "key" (unique), "name", "unit", "cost".
        </p>
    </div>

    <div class="form-group">
        <label>Import Base</label>
        <div class="flexrow">
            <select name="importMode">
                <option value="overwrite">Overwrite current table</option>
                <option value="merge">Merge (add missing keys only)</option>
            </select>
            <button type="button" class="import-base">Import Base</button>
        </div>
    </div>

    <footer class="sheet-footer flexrow">
        <button type="submit" class="save"><i class="fas fa-save"></i> Save</button>
        <button type="button" class="close"><i class="fas fa-times"></i> Close</button>
    </footer>
</form>
