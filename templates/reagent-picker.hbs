<form class="reagent-picker flexcol" autocomplete="off">
  <header class="picker-header" style="text-align:center; margin-bottom:.5rem;">
    <h2 style="font-family:'Modesto Poster',serif; color:#a11; font-size:1.6em; text-shadow:1px 1px 2px rgba(0,0,0,0.3);">
      Spell: {{current.spellNameCached}}
    </h2>
  </header>

  <section class="picker-body flexcol" style="gap:.75rem; padding:0 .5rem;">
    <h3 style="font-weight:bold; font-size:1.1em; margin-bottom:.25rem;">Current Mapping:</h3>

    <div class="mapping-box" style="position:relative; padding:.5rem; background:rgba(0,0,0,0.05); border-radius:6px;">
      <select name="compUuid"
        style="width:100%; max-width:100%; font-size:.95em; padding:.25rem;
               overflow:hidden; text-overflow:ellipsis;">
        <option value="" {{#unless current.reagentUUID}}selected{{/unless}}>— No Reagent Selected —</option>
        {{#each (sort compendium 'name')}}
          <option value="{{this.uuid}}"
            {{#if (eq ../current.reagentUUID this.uuid)}}selected{{/if}}>
            {{this.name}}
          </option>
        {{/each}}
      </select>

      {{#if current.reagentUUID}}
        <div style="margin-top:.4rem; font-size:.85em; color:#444;">
          <div>key: {{current.reagentKey}}</div>
          <div>uuid: {{current.reagentUUID}}</div>
          <a href="#" data-action="open-compendium" data-uuid="{{current.reagentUUID}}" style="color:black;">
            🔗 Open in Compendium
          </a>
        </div>

        <button type="button"
                data-action="clear-mapping"
                title="Remove reagent link"
                style="position:absolute; bottom:.4rem; right:.4rem;
                       background:#a00; color:#fff; border:none;
                       border-radius:50%; width:22px; height:22px;
                       font-size:.9em; line-height:1; text-align:center; cursor:pointer;">
          ✖
        </button>
      {{/if}}
    </div>

    <h3 style="font-weight:bold; font-size:1.1em; margin-top:.75rem; color:black;">Options:</h3>

    <div class="form-group">
      <label><input type="checkbox" name="consumed" {{#if current.consumed}}checked{{/if}}> Consumed on Cast</label>
    </div>
  </section>

  <footer class="picker-footer flexrow" style="justify-content:center; margin-top:1rem; position:relative;">
    <style>
      .save-btn {
        background: #4a7350;
        color: #f0f0f0;
        padding: .4rem 1.2rem;
        border: 1px solid #3a5a3f;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }
      .save-btn:hover {
        background: #3f6245;
      }
    </style>

    <button type="submit" class="save-btn">💾 Save</button>
  </footer>
</form>
