<section class="spell-map">
  <header
    class="flexrow"
    style="
      gap:.75rem;
      align-items:center;
      position:sticky;
      top:0;
      background:#b8b8b8;
      padding:.6rem .75rem;
      z-index:2;
      border-bottom:1px solid rgba(0,0,0,.2);
      box-shadow:0 1px 0 rgba(0,0,0,.05);
    "
  >
    <!-- Left column: Save -->
    <div class="flexcol" style="gap:.35rem; min-width:9rem;">
      <button
        type="button"
        data-action="save"
        class="save"
        title="Save world overrides"
        style="padding:.3rem .5rem; width:8rem; font-size:.85em;"
      >
        <i class="fas fa-save"></i> Save
      </button>
      <div style="font-size:.95em; margin-top:.35rem;">Packs: {{packs}}</div>
    </div>

    <!-- Center column: Filter + Search -->
    <div style="flex:1;">
      <div
        style="
          display:grid;
          grid-template-columns: 58px 12rem 18px auto;
          grid-auto-rows: minmax(26px,auto);
          align-items:center;
          column-gap:.5rem;
          row-gap:.45rem;
        "
      >
        <!-- Row 1: Filter + Only costly/consumed -->
        <label style="grid-column:1;">Filter:</label>
        <select name="filter" style="grid-column:2; height:26px; width:10rem;">
          <option value="">All</option>
          <option value="unmapped">Unmapped</option>
          <option value="guessed">Guessed</option>
          <option value="confirmed">Confirmed</option>
          <option value="staleUUID">Stale UUID</option>
        </select>
        <input type="checkbox" name="onlyCostly" style="grid-column:3; transform:scale(.85);" />
        <span style="grid-column:4;">Only costly/consumed</span>

        <!-- Row 2: Search -->
        <label style="grid-column:1;">Search:</label>
        <input
          type="text"
          name="search"
          placeholder="Spell or Reagent name"
          style="grid-column:2 / 5; height:26px; width:13rem; font-size:.9em;"
        />
      </div>
    </div>
  </header>

  <p class="hint muted" style="margin:.35rem .5rem .5rem .5rem;">
    Total: {{counts.total}}
    &nbsp;•&nbsp; Unmapped: {{counts.unmapped}}
    &nbsp;•&nbsp; Guessed: {{counts.guessed}}
    &nbsp;•&nbsp; Confirmed: {{counts.confirmed}}
    &nbsp;•&nbsp; Stale: {{counts.stale}}
  </p>

  <table class="spell-map-table" style="width:100%; border-collapse:separate; border-spacing:0 .25rem;">
    <thead>
      <tr style="text-align:left;">
        <th style="width:38%; padding:.25rem .5rem;">Spell</th>
        <th style="width:18%; padding:.25rem .5rem;">Pack</th>
        <th style="width:12%; padding:.25rem .5rem;">Status</th>
        <th style="width:24%; padding:.25rem .5rem;">Reagent (from Compendium)</th>
        <th style="width:8%; padding:.25rem .5rem; text-align:center;">Actions</th>
      </tr>
    </thead>

    <tbody>
      {{#each rows}}
      <tr
        data-index="{{@index}}"
        data-status="{{this.status}}"
        data-spellname="{{this.spellNameCached}}"
        data-costly="{{this.hasNativeCostOrConsumed}}"
        style="background:rgba(0,0,0,0.06);"
      >
        <td style="padding:.5rem .5rem;">
          <div class="spell-name" style="font-weight:600;">{{this.spellNameCached}}</div>
          <div class="muted uuid" style="font-size:.85em; word-break:break-all;">{{this.spellUUID}}</div>
        </td>

        <td style="padding:.5rem .5rem;">
          <span class="muted">{{this.spellPackCached}}</span>
        </td>

        <td style="padding:.5rem .5rem;">
          <span class="status badge" style="text-transform:capitalize;">{{this.status}}</span>
        </td>

        <td class="reagent-cell" style="padding:.5rem .5rem;">
          {{#if this.reagents}}
            {{#with (lookup this.reagents 0) as |g|}}
              <div style="font-weight:600;">{{g.reagentNameCached}}</div>
              <div class="muted small" style="font-size:.9em;">
                {{#if g.reagentKey}}key: {{g.reagentKey}}{{/if}}
                {{#if g.reagentUUID}}uuid: {{g.reagentUUID}}{{/if}}
                {{#if g.minCost}} | min {{g.minCost}} gp{{/if}}
                | qty {{#if g.quantity}}{{g.quantity}}{{else}}1{{/if}}
                | {{#if g.consumed}}consumed{{else}}not consumed{{/if}}
              </div>
            {{/with}}
          {{else}}
            <em class="muted">none</em>
          {{/if}}
        </td>

        <td class="actions" style="padding:.25rem .25rem; text-align:center; white-space:nowrap;">
          <button type="button" data-action="pick-reagent" data-index="{{@index}}" title="Pick reagent from compendium"><i class="fas fa-pen"></i></button>
          <button type="button" data-action="mark-confirmed" data-index="{{@index}}" title="Mark confirmed"><i class="fas fa-check"></i></button>
          <button type="button" data-action="mark-unmapped" data-index="{{@index}}" title="Mark unmapped"><i class="fas fa-undo"></i></button>
          <button type="button" data-action="delete" data-index="{{@index}}" title="Remove row"><i class="fas fa-trash"></i></button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</section>
